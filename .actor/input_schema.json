{
  "title": "Universal Document Extractor Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "docBinary": {
      "title": "Document Binary (n8n format)",
      "type": "object",
      "description": "n8n binary data wrapper containing base64 encoded document",
      "properties": {
        "data": {
          "title": "Base64 Encoded Document",
          "type": "string",
          "description": "Base64 encoded PDF or image file",
          "editor": "textfield"
        }
      },
      "required": ["data"]
    },
    "docBase64": {
      "title": "Document Base64 (alternative)",
      "type": "string",
      "description": "Alternative field for direct base64 input",
      "editor": "textfield"
    },
    "base64_data": {
      "title": "Base64 Data (alternative)",
      "type": "string",
      "description": "Alternative field for direct base64 input",
      "editor": "textfield"
    },
    "mimeType": {
      "title": "MIME Type",
      "type": "string",
      "description": "Document MIME type (default: application/pdf)",
      "editor": "textfield",
      "default": "application/pdf",
      "pattern": "^(application/pdf|image/(png|jpeg|jpg|webp))$"
    },
    "outputFormat": {
      "title": "Output Format",
      "type": "string",
      "description": "Output format selection",
      "editor": "select",
      "default": "json",
      "enum": ["json", "detailed"]
    }
  },
  "anyOf": [
    { "required": ["docBinary"] },
    { "required": ["docBase64"] },
    { "required": ["base64_data"] }
  ]
}
