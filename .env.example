# DocuFlow Headless v2 Environment Configuration

# ==============================================================================
# MODAL ENDPOINTS CONFIGURATION
# ==============================================================================

# CPU Endpoint (Granite-Docling with llama.cpp optimization)
MODAL_CPU_ENDPOINT=https://ap3617180--docuflow-cpu-granite-serve.modal.run

# GPU Endpoint (DeepSeek-OCR with vLLM + AWQ quantization)
MODAL_GPU_ENDPOINT=https://ap3617180--docuflow-gpu-deepseek-serve.modal.run

# ==============================================================================
# GROQ API CONFIGURATION
# ==============================================================================

# Groq API Key for LLM processing
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# API Key for external services
API_KEY=your_api_key_here

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/docuflow

# Redis connection for caching
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable structured logging
STRUCTURED_LOGGING=true

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ==============================================================================
# APIFY ACTOR CONFIGURATION
# ==============================================================================

# Apify API token
APIFY_TOKEN=your_apify_token_here

# Actor timeout in seconds
ACTOR_TIMEOUT=300

# Maximum file size in MB
MAX_FILE_SIZE=50

# ==============================================================================
# MODAL DEPLOYMENT CONFIGURATION
# ==============================================================================

# Modal API token for deployments
MODAL_TOKEN=your_modal_token_here

# Keep warm settings for business hours
MODAL_KEEP_WARM=1

# Container idle timeout in seconds
MODAL_SCALEDOWN_WINDOW=300

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# CPU thread count for processing
CPU_THREADS=4

# GPU memory utilization (0.1-1.0)
GPU_MEMORY_UTILIZATION=0.95

# Batch size for processing
BATCH_SIZE=512

# Context size for models
CONTEXT_SIZE=4096

# ==============================================================================
# ANTI-HALLUCINATION SETTINGS
# ==============================================================================

# Enable strict schema validation
STRICT_SCHEMA_VALIDATION=true

# Force optional fields only (prevent fake data)
FORCE_OPTIONAL_FIELDS=true

# Maximum tokens for LLM responses
MAX_LLM_TOKENS=1000

# Temperature for LLM sampling (0.0-1.0)
LLM_TEMPERATURE=0.1

# ==============================================================================
# N8N INTEGRATION
# ==============================================================================

# n8n webhook URL for notifications
N8N_WEBHOOK_URL=

# Enable n8n workflow notifications
ENABLE_N8N_NOTIFICATIONS=false

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Enable debug mode
DEBUG=false

# Enable detailed error messages
DETAILED_ERRORS=false

# Mock external services for testing
MOCK_EXTERNAL_SERVICES=false

# Test mode (bypasses some validations)
TEST_MODE=false