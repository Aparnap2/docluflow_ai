# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.1-70b-versatile

# Modal Deployment URLs (Update these after deployment)
MODAL_GRANITE_URL=https://your-username--granite-docling-cpu.modal.run
MODAL_DEEPSEEK_URL=https://your-username--deepseek-ocr-gpu.modal.run

# Ollama Configuration (for local development)
OLLAMA_HOST=http://localhost:11434

# Processing Configuration
DEFAULT_LLM_PROVIDER=groq
CPU_PROCESSING_TIMEOUT=60
GPU_PROCESSING_TIMEOUT=120
MAX_RETRY_ATTEMPTS=3

# Anti-Hallucination Settings
CONFIDENCE_THRESHOLD=0.7
FORCE_OPTIONAL_FIELDS=true
VALIDATE_SCHEMA=true

# Logging Configuration
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# Security Configuration (for enterprise features)
MODAL_API_KEY=your_modal_api_key_here
REDIS_URL=redis://localhost:6379
SECURITY_LEVEL=standard